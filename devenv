cleanup() {
    if [[ -n "$DEVCONTAINER_CACHE" && -f "$DEVCONTAINER_CACHE" ]]; then
        rm -f "$DEVCONTAINER_CACHE"
    fi

    if [[ -n "$COMPOSE_RUNTIME_OVERRIDE" && -f "$COMPOSE_RUNTIME_OVERRIDE" ]]; then
        rm -f "$COMPOSE_RUNTIME_OVERRIDE"
    fi

    if [[ -n "$DEV_SESSION_LAYOUT" && -f "$DEV_SESSION_LAYOUT" ]]; then
        rm -f "$DEV_SESSION_LAYOUT"
    fi

    if [[ -n "$DEV_SESSION_SHELL_LAUNCHER" && -f "$DEV_SESSION_SHELL_LAUNCHER" ]]; then
        rm -f "$DEV_SESSION_SHELL_LAUNCHER"
    fi
}

trap cleanup EXIT
trap 'print_warning "Script interrupted by user"; exit 130' INT

print_step() {
    echo -e "${BLUE}==> $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}" >&2
}

print_warning() {
    echo -e "${YELLOW}! $1${NC}" >&2
}

print_error() {
    echo -e "${RED}✗ $1${NC}" >&2
}

die() {
    print_error "$1" >&2
    exit 1
}

