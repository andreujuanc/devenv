docker_exec_base() {
    local exec_mode="$1"
    local container_id="$2"
    local exec_user="${3:-$REMOTE_USER}"
    local -a command=(docker exec)
    local -a remote_env_args=()

    mapfile -d '' -t remote_env_args < <(remote_env_args_for_container "$container_id")

    if [[ "$exec_mode" == "interactive" ]]; then
        command+=(-it)
    else
        command+=(-i)
    fi

    if [[ -n "$exec_user" ]]; then
        command+=(-u "$exec_user")
    fi

    command+=("${remote_env_args[@]}")
    command+=(-w "$WORKSPACE_FOLDER" "$container_id")
    printf '%s\0' "${command[@]}"
}

container_path_exists() {
    local container_id="$1"
    local candidate_path="$2"
    local -a exec_args=()

    mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
    "${exec_args[@]}" /bin/sh -c "test -x $(shell_escape "$candidate_path")" >/dev/null 2>&1
}

open_container_shell() {
