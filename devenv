zellij_session_status() {
    local session_name="$1"
    local session_line
    local listed_session_name

    while IFS= read -r session_line; do
        [[ "$session_line" == *" [Created "* ]] || continue
        listed_session_name="${session_line%% [Created *}"
        [[ "$listed_session_name" == "$session_name" ]] || continue

        case "$session_line" in
            *"(EXITED"*)
                printf 'EXITED\n'
                return 0
                ;;
            *"(KILLED"*)
                printf 'KILLED\n'
                return 0
                ;;
            *)
                printf 'ACTIVE\n'
                return 0
                ;;
        esac
    done < <(zellij list-sessions --no-formatting 2>/dev/null || true)

    printf 'MISSING\n'
}

open_zellij_session() {
    local session_kind="$1"
    local session_name="$2"
    local session_layout="$3"
    local session_status

    session_status="$(zellij_session_status "$session_name")"

    case "$session_status" in
        ACTIVE)
            print_step "Attaching zellij $session_kind session '$session_name'"
            SHELL="$DEV_SESSION_SHELL_LAUNCHER" zellij attach "$session_name"
            ;;
        EXITED|KILLED)
            print_step "Removing stale zellij session '$session_name' ($session_status)"
            zellij kill-session "$session_name" >/dev/null 2>&1 || true
            zellij delete-session --force "$session_name" >/dev/null 2>&1 || true
            print_step "Starting zellij $session_kind session '$session_name'"
            SHELL="$DEV_SESSION_SHELL_LAUNCHER" zellij --session "$session_name" --new-session-with-layout "$session_layout"
            ;;
        *)
            print_step "Starting zellij $session_kind session '$session_name'"
            SHELL="$DEV_SESSION_SHELL_LAUNCHER" zellij --session "$session_name" --new-session-with-layout "$session_layout"
            ;;
    esac
}

