$(script_asset_content "scripts/install/zellij.sh")"
                ;;
        esac
    done

    if [[ ${#package_tools[@]} -gt 0 ]]; then
        run_or_print_host_command "$(host_package_install_command "${package_tools[@]}")"
    fi

    if [[ $PRINT_ONLY -eq 0 ]]; then
        if ! path_contains_directory "$HOME/.local/bin"; then
            print_warning "Add '$HOME/.local/bin' to PATH if you install host binaries there"
        fi
    fi
}

container_has_tool_script() {
    case "$1" in
        jq|git|ranger|lf|eza|tree|lazygit|micro|fresh)
            printf 'command -v %s >/dev/null 2>&1\n' "$1"
            ;;
        helix)
            printf 'command -v hx >/dev/null 2>&1\n'
            ;;
        yazi)
            printf 'command -v yazi >/dev/null 2>&1\n'
            ;;
        copilot)
            printf 'command -v copilot >/dev/null 2>&1\n'
            ;;
        opencode)
            printf 'command -v opencode >/dev/null 2>&1\n'
            ;;
        *)
            return 1
            ;;
    esac
}

