#!/usr/bin/env bash

set -euo pipefail

VERSION="0.1.0"
DEFAULT_DEVCONTAINER_JSON=".devcontainer/devcontainer.json"
FALLBACK_DEVCONTAINER_JSON=".devcontainer.json"
DEFAULT_INSTALL_PREFIX="${HOME}/.local/bin"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PROJECT_ROOT=""
DEVCONTAINER_JSON=""
DEVCONTAINER_DIR=""
DEVCONTAINER_CACHE=""
WORKSPACE_HINT=""
PROJECT_NAME_OVERRIDE=""
SERVICE_OVERRIDE=""
REMOVE_ON_EXIT=0
INSTALL_PREFIX="$DEFAULT_INSTALL_PREFIX"
INSTALL_MODE="copy"
FORCE_INSTALL=0
DISPLAY_NAME=""
SCENARIO=""
SERVICE_NAME=""
WORKSPACE_FOLDER=""
REMOTE_USER=""
PROJECT_NAME=""
PROJECT_HASH=""
PROJECT_STATE_DIR=""
TOOL_NAME=""
SUBCOMMAND=""
PRINT_ONLY=0

declare -a COMPOSE_FILES=()
declare -a COMPOSE_ARGS=()
declare -a RUN_SERVICES=()
declare -a EXEC_ARGS=()
declare -a TOOL_ARGS=()

cleanup() {
    if [[ -n "$DEVCONTAINER_CACHE" && -f "$DEVCONTAINER_CACHE" ]]; then
        rm -f "$DEVCONTAINER_CACHE"
    fi
}

trap cleanup EXIT
trap 'print_warning "Script interrupted by user"; exit 130' INT

print_step() {
    echo -e "${BLUE}==> $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}" >&2
}

print_warning() {
    echo -e "${YELLOW}! $1${NC}" >&2
}

print_error() {
    echo -e "${RED}✗ $1${NC}" >&2
}

die() {
    print_error "$1" >&2
    exit 1
}

usage() {
        cat <<'EOF'
Usage:
    devenv
    devenv open [project_name] [--workspace PATH] [--rm]
    devenv up [--workspace PATH] [--project-name NAME]
    devenv down [--workspace PATH] [--project-name NAME]
    devenv shell [--workspace PATH] [--project-name NAME] [--service NAME]
    devenv exec [--workspace PATH] [--project-name NAME] [--service NAME] -- <command> [args...]
    devenv tool <helix|tmux|files> [--workspace PATH] [--project-name NAME] [--service NAME] [-- args...]
    devenv host-tool <list|check|install> [tool...] [--print]
    devenv container-tool <list|check|install> [tool...] [--print]
    devenv host-tmux [--workspace PATH] [--project-name NAME] [--service NAME]
    devenv logs [--workspace PATH] [--project-name NAME] [--service NAME]
    devenv ps [--workspace PATH] [--project-name NAME]
    devenv config [--workspace PATH] [--project-name NAME]
    devenv check [--workspace PATH]
    devenv install [--prefix PATH] [--mode copy|symlink] [--force]
    devenv uninstall [--prefix PATH]
    devenv help

Commands:
    open       Start the environment and attach a shell. Use --rm to stop it on shell exit.
    up         Start the environment and run supported lifecycle commands.
    down       Stop and remove the environment.
    shell      Open a shell in the configured service without tearing the stack down on exit.
    exec       Run a command inside the configured service.
    tool       Launch an optional built-in terminal tool inside the configured service.
    host-tool  Manage host-side helper tools such as jq, tmux, helix, lapce, and copilot.
    container-tool Manage container-side helper tools such as jq, tmux, helix, and copilot.
    host-tmux  Create or attach to a host tmux session for the current repo.
    logs       Show compose logs for the repo environment.
    ps         Show compose service status for the repo environment.
    config     Print discovered repo and devcontainer settings.
    check      Validate host prerequisites and the repo contract.
    install    Install devenv into a directory on your PATH.
    uninstall  Remove an installed devenv from a directory on your PATH.
    help       Show this message.

Options:
    --workspace, -w     Workspace or subdirectory inside the target repo.
    --project-name, -p  Override the derived compose project name.
    --service, -s       Override the primary service from devcontainer.json.
    --prefix            Install or uninstall target directory. Defaults to ~/.local/bin.
    --mode              Install using a copied file or a symlink. Defaults to copy.
    --force             Replace an existing installed file.
    --rm                Stop services when the shell from `open` exits.
    --print             Print install commands instead of running them.
    --help, -h          Show this message.

Notes:
    - v1 is intentionally shell-only and does not use the devcontainer CLI.
    - v1 currently supports repos whose .devcontainer config defines dockerComposeFile.
    - Editor customizations, features, and automatic port forwarding are not applied by this wrapper.
    - `devenv tool ...` is optional and only works when the repo image provides those binaries.
    - `devenv host-tmux` uses tmux on the host and keeps all SDKs and app commands in containers.
        - `host-tool` installs host UX and launcher dependencies; `container-tool` installs mutable extras inside the active container.
EOF
}

host_tool_help() {
        cat <<'EOF'
Usage:
    devenv host-tool list
    devenv host-tool check [jq|tmux|helix|lapce|copilot ...]
    devenv host-tool install <jq|tmux|helix|lapce|copilot ...> [--print]

Notes:
    - Host installs are Linux-oriented and depend on the available package manager.
    - `copilot` uses: curl -fsSL https://gh.io/copilot-install | bash
    - `lapce` installs the latest AppImage into ~/.local/bin/lapce.
EOF
}

container_tool_help() {
        cat <<'EOF'
Usage:
    devenv container-tool list
    devenv container-tool check [jq|tmux|helix|yazi|ranger|lf|copilot ...]
    devenv container-tool install <jq|tmux|helix|yazi|ranger|lf|copilot ...> [--print]

Notes:
    - Container installs are mutable and can disappear when the container is recreated.
    - Move persistent tooling into the repo image once you know you want it.
    - `copilot` uses: curl -fsSL https://gh.io/copilot-install | bash
EOF
}

require_command() {
    local command_name="$1"
    local hint="$2"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "Required command '$command_name' not found. $hint"
    fi
}

jsonc_to_json() {
    awk '
        BEGIN {
            in_block_comment = 0
        }
        {
            line = $0
            output = ""
            in_string = 0
            escaped = 0
            i = 1
            while (i <= length(line)) {
                ch = substr(line, i, 1)
                next_ch = substr(line, i + 1, 1)

                if (in_block_comment) {
                    if (ch == "*" && next_ch == "/") {
                        in_block_comment = 0
                        i += 2
                        continue
                    }
                    i++
                    continue
                }

                if (escaped) {
                    output = output ch
                    escaped = 0
                    i++
                    continue
                }

                if (ch == "\\" && in_string) {
                    output = output ch
                    escaped = 1
                    i++
                    continue
                }

                if (ch == "\"") {
                    output = output ch
                    in_string = !in_string
                    i++
                    continue
                }

                if (!in_string && ch == "/" && next_ch == "*") {
                    in_block_comment = 1
                    i += 2
                    continue
                }

                if (!in_string && ch == "/" && next_ch == "/") {
                    break
                }

                output = output ch
                i++
            }
            print output
        }
    ' "$1"
}

ensure_devcontainer_cache() {
    if [[ -n "$DEVCONTAINER_CACHE" && -f "$DEVCONTAINER_CACHE" ]]; then
        return
    fi

    [[ -n "$DEVCONTAINER_JSON" ]] || die "Internal error: devcontainer path not initialized"

    DEVCONTAINER_CACHE="$(mktemp)"
    jsonc_to_json "$DEVCONTAINER_JSON" > "$DEVCONTAINER_CACHE"

    if ! jq empty "$DEVCONTAINER_CACHE" >/dev/null 2>&1; then
        die "Failed to parse $DEVCONTAINER_JSON. Ensure it contains valid JSON or JSONC."
    fi
}

json_query_optional() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -er "$filter // empty" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

json_query_required() {
    local filter="$1"
    local description="$2"
    local value

    value="$(json_query_optional "$filter")"
    if [[ -z "$value" ]]; then
        die "Required field '$description' not found in $DEVCONTAINER_JSON"
    fi

    printf '%s\n' "$value"
}

json_has_value() {
    local field="$1"
    ensure_devcontainer_cache
    jq -e --arg field "$field" 'has($field) and .[$field] != null' "$DEVCONTAINER_CACHE" >/dev/null 2>&1
}

json_query_lines() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -r "$filter" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

json_query_compact_lines() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -c "$filter" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

field_type() {
    local field="$1"
    ensure_devcontainer_cache
    jq -r --arg field "$field" 'if has($field) and .[$field] != null then (.[$field] | type) else "missing" end' "$DEVCONTAINER_CACHE"
}

absolute_directory_path() {
    (
        cd "$1" >/dev/null 2>&1 && pwd -P
    )
}

absolute_file_path() {
    local directory_path
    directory_path="$(absolute_directory_path "$(dirname "$1")")"
    printf '%s/%s\n' "$directory_path" "$(basename "$1")"
}

resolve_workspace_start() {
    if [[ -z "$WORKSPACE_HINT" ]]; then
        pwd -P
        return
    fi

    if [[ -d "$WORKSPACE_HINT" ]]; then
        absolute_directory_path "$WORKSPACE_HINT"
        return
    fi

    if [[ -f "$WORKSPACE_HINT" ]]; then
        absolute_file_path "$WORKSPACE_HINT"
        return
    fi

    die "Workspace path '$WORKSPACE_HINT' does not exist"
}

discover_workspace() {
    local start_path current_path
    start_path="$(resolve_workspace_start)"

    if [[ -f "$start_path" ]]; then
        DEVCONTAINER_JSON="$start_path"
        if [[ "$(basename "$DEVCONTAINER_JSON")" == "devcontainer.json" ]]; then
            PROJECT_ROOT="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")/..")"
        else
            PROJECT_ROOT="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")")"
        fi
        DEVCONTAINER_DIR="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")")"
        return
    fi

    current_path="$start_path"
    while [[ "$current_path" != "/" ]]; do
        if [[ -f "$current_path/$DEFAULT_DEVCONTAINER_JSON" ]]; then
            PROJECT_ROOT="$current_path"
            DEVCONTAINER_JSON="$current_path/$DEFAULT_DEVCONTAINER_JSON"
            DEVCONTAINER_DIR="$current_path/.devcontainer"
            return
        fi

        if [[ -f "$current_path/$FALLBACK_DEVCONTAINER_JSON" ]]; then
            PROJECT_ROOT="$current_path"
            DEVCONTAINER_JSON="$current_path/$FALLBACK_DEVCONTAINER_JSON"
            DEVCONTAINER_DIR="$current_path"
            return
        fi

        current_path="$(dirname "$current_path")"
    done

    die "Could not find $DEFAULT_DEVCONTAINER_JSON or $FALLBACK_DEVCONTAINER_JSON from the current directory"
}

sanitize_identifier() {
    local value="$1"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    if [[ -z "$value" ]]; then
        value="workspace"
    fi
    printf '%s\n' "$value"
}

derive_project_hash() {
    printf '%s' "$PROJECT_ROOT" | cksum | awk '{print $1}'
}

build_project_name() {
    local base_name

    if [[ -n "$PROJECT_NAME_OVERRIDE" ]]; then
        printf '%s\n' "$(sanitize_identifier "$PROJECT_NAME_OVERRIDE")"
        return
    fi

    base_name="$(sanitize_identifier "$(basename "$PROJECT_ROOT")")"
    printf '%s-%s\n' "$base_name" "$PROJECT_HASH"
}

resolve_compose_files() {
    local compose_entry resolved_path

    mapfile -t COMPOSE_FILES < <(json_query_lines '.dockerComposeFile | if type == "array" then .[] else . end')
    if [[ ${#COMPOSE_FILES[@]} -eq 0 ]]; then
        die "The current v1 implementation requires dockerComposeFile in $DEVCONTAINER_JSON"
    fi

    COMPOSE_ARGS=()
    for compose_entry in "${COMPOSE_FILES[@]}"; do
        if [[ "$compose_entry" = /* ]]; then
            resolved_path="$compose_entry"
        else
            resolved_path="$DEVCONTAINER_DIR/$compose_entry"
        fi

        resolved_path="$(absolute_file_path "$resolved_path")"
        [[ -f "$resolved_path" ]] || die "Compose file '$resolved_path' does not exist"

        COMPOSE_ARGS+=(-f "$resolved_path")
    done
}

load_run_services() {
    mapfile -t RUN_SERVICES < <(json_query_lines '.runServices // [] | .[]')

    if [[ ${#RUN_SERVICES[@]} -gt 0 ]]; then
        local found=0
        local run_service
        for run_service in "${RUN_SERVICES[@]}"; do
            if [[ "$run_service" == "$SERVICE_NAME" ]]; then
                found=1
                break
            fi
        done

        if [[ $found -eq 0 ]]; then
            RUN_SERVICES+=("$SERVICE_NAME")
        fi
    fi
}

load_workspace_context() {
    discover_workspace
    require_command jq "Install jq to parse devcontainer.json files."
    ensure_devcontainer_cache

    if json_has_value "dockerComposeFile"; then
        SCENARIO="compose"
    else
        die "Unsupported devcontainer configuration in $DEVCONTAINER_JSON. v1 currently supports only dockerComposeFile-based repos."
    fi

    DISPLAY_NAME="$(json_query_optional '.name')"
    if [[ -z "$DISPLAY_NAME" ]]; then
        DISPLAY_NAME="$(basename "$PROJECT_ROOT")"
    fi

    SERVICE_NAME="$(json_query_required '.service' 'service')"
    if [[ -n "$SERVICE_OVERRIDE" ]]; then
        SERVICE_NAME="$SERVICE_OVERRIDE"
    fi

    WORKSPACE_FOLDER="$(json_query_optional '.workspaceFolder')"
    if [[ -z "$WORKSPACE_FOLDER" ]]; then
        WORKSPACE_FOLDER="/workspaces/$(basename "$PROJECT_ROOT")"
    fi

    REMOTE_USER="$(json_query_optional '.remoteUser // .containerUser')"
    PROJECT_HASH="$(derive_project_hash)"
    PROJECT_NAME="$(build_project_name)"
    PROJECT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devenv/$PROJECT_HASH"
    mkdir -p "$PROJECT_STATE_DIR"

    resolve_compose_files
    load_run_services
}

emit_spec_warnings() {
    if json_has_value "features"; then
        print_warning "This wrapper does not install Dev Container features. Use images that already contain required tooling."
    fi

    if json_has_value "customizations"; then
        print_warning "Editor customizations are ignored by this editor-agnostic wrapper."
    fi

    if json_has_value "forwardPorts"; then
        print_warning "forwardPorts is metadata only here. Publish ports in compose or rely on your editor to forward them."
    fi
}

require_compose() {
    require_command docker "Install Docker and ensure it is on your PATH."
    if ! docker compose version >/dev/null 2>&1; then
        die "Docker Compose v2 is required. Ensure 'docker compose' works on this machine."
    fi
}

self_path() {
    absolute_file_path "${BASH_SOURCE[0]}"
}

shell_escape() {
    printf '%q' "$1"
}

path_contains_directory() {
    local target="$1"
    local path_entry

    IFS=':' read -r -a path_entries <<< "$PATH"
    for path_entry in "${path_entries[@]}"; do
        if [[ "$path_entry" == "$target" ]]; then
            return 0
        fi
    done

    return 1
}

normalize_helper_tool() {
    case "$1" in
        jq)
            printf 'jq\n'
            ;;
        tmux)
            printf 'tmux\n'
            ;;
        helix|hx)
            printf 'helix\n'
            ;;
        lapce)
            printf 'lapce\n'
            ;;
        copilot|copilot-cli|github-copilot-cli)
            printf 'copilot\n'
            ;;
        yazi)
            printf 'yazi\n'
            ;;
        ranger)
            printf 'ranger\n'
            ;;
        lf)
            printf 'lf\n'
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

host_tool_supported() {
    case "$1" in
        jq|tmux|helix|lapce|copilot)
            return 0
            ;;
    esac
    return 1
}

container_tool_supported() {
    case "$1" in
        jq|tmux|helix|yazi|ranger|lf|copilot)
            return 0
            ;;
    esac
    return 1
}

host_tool_list() {
    printf 'jq\n'
    printf 'tmux\n'
    printf 'helix\n'
    printf 'lapce\n'
    printf 'copilot\n'
}

container_tool_list() {
    printf 'jq\n'
    printf 'tmux\n'
    printf 'helix\n'
    printf 'yazi\n'
    printf 'ranger\n'
    printf 'lf\n'
    printf 'copilot\n'
}

require_tool_args() {
    [[ ${#TOOL_ARGS[@]} -gt 0 ]] || die "$1"
}

load_default_tool_args() {
    local scope="$1"

    if [[ ${#TOOL_ARGS[@]} -gt 0 ]]; then
        return
    fi

    mapfile -t TOOL_ARGS < <(
        if [[ "$scope" == "host" ]]; then
            host_tool_list
        else
            container_tool_list
        fi
    )
}

validate_tool_args() {
    local scope="$1"
    local -a normalized=()
    local tool

    for tool in "${TOOL_ARGS[@]}"; do
        tool="$(normalize_helper_tool "$tool")"
        if [[ "$scope" == "host" ]]; then
            host_tool_supported "$tool" || die "Unsupported host tool '$tool'"
        else
            container_tool_supported "$tool" || die "Unsupported container tool '$tool'"
        fi
        normalized+=("$tool")
    done

    TOOL_ARGS=("${normalized[@]}")
}

host_has_tool() {
    local tool="$1"

    case "$tool" in
        jq|tmux)
            command -v "$tool" >/dev/null 2>&1
            ;;
        helix)
            command -v hx >/dev/null 2>&1
            ;;
        lapce)
            command -v lapce >/dev/null 2>&1
            ;;
        copilot)
            command -v copilot >/dev/null 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

command_host_tool_check() {
    local failures=0
    local tool

    load_default_tool_args host
    validate_tool_args host

    for tool in "${TOOL_ARGS[@]}"; do
        if host_has_tool "$tool"; then
            print_success "host tool '$tool' is installed"
        else
            print_warning "host tool '$tool' is missing"
            failures=1
        fi
    done

    return $failures
}

detect_host_package_manager() {
    if command -v apt-get >/dev/null 2>&1; then
        printf 'apt-get\n'
        return
    fi
    if command -v dnf >/dev/null 2>&1; then
        printf 'dnf\n'
        return
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf 'pacman\n'
        return
    fi
    if command -v zypper >/dev/null 2>&1; then
        printf 'zypper\n'
        return
    fi
    if command -v apk >/dev/null 2>&1; then
        printf 'apk\n'
        return
    fi

    die "No supported package manager found on the host"
}

host_package_install_command() {
    local package_manager="$1"
    shift
    local -a packages=("$@")
    local joined_packages="${packages[*]}"

    case "$package_manager" in
        apt-get)
            printf 'sudo apt-get update && sudo apt-get install -y %s\n' "$joined_packages"
            ;;
        dnf)
            printf 'sudo dnf install -y %s\n' "$joined_packages"
            ;;
        pacman)
            printf 'sudo pacman -Sy --noconfirm %s\n' "$joined_packages"
            ;;
        zypper)
            printf 'sudo zypper --non-interactive install %s\n' "$joined_packages"
            ;;
        apk)
            printf 'sudo apk add --no-cache %s\n' "$joined_packages"
            ;;
        *)
            die "Unsupported package manager '$package_manager'"
            ;;
    esac
}

run_or_print_host_command() {
    local command_string="$1"

    if [[ $PRINT_ONLY -eq 1 ]]; then
        printf '%s\n' "$command_string"
        return
    fi

    bash -lc "$command_string"
}

command_host_tool_install() {
    local package_manager
    local -a package_tools=()
    local tool

    require_tool_args "No host tools provided. Use: devenv host-tool install <jq|tmux|helix|lapce|copilot ...>"
    validate_tool_args host

    for tool in "${TOOL_ARGS[@]}"; do
        case "$tool" in
            jq|tmux|helix)
                package_tools+=("$tool")
                ;;
            lapce)
                run_or_print_host_command 'mkdir -p "$HOME/.local/bin" && curl -fsSL https://github.com/lapce/lapce/releases/latest/download/Lapce-linux.AppImage -o "$HOME/.local/bin/lapce" && chmod +x "$HOME/.local/bin/lapce"'
                ;;
            copilot)
                run_or_print_host_command 'curl -fsSL https://gh.io/copilot-install | bash'
                ;;
        esac
    done

    if [[ ${#package_tools[@]} -gt 0 ]]; then
        package_manager="$(detect_host_package_manager)"
        run_or_print_host_command "$(host_package_install_command "$package_manager" "${package_tools[@]}")"
    fi

    if [[ $PRINT_ONLY -eq 0 ]]; then
        if ! path_contains_directory "$HOME/.local/bin"; then
            print_warning "Add '$HOME/.local/bin' to PATH if you install host binaries there"
        fi
    fi
}

container_has_tool_script() {
    case "$1" in
        jq|tmux|ranger|lf)
            printf 'command -v %s >/dev/null 2>&1\n' "$1"
            ;;
        helix)
            printf 'command -v hx >/dev/null 2>&1\n'
            ;;
        yazi)
            printf 'command -v yazi >/dev/null 2>&1\n'
            ;;
        copilot)
            printf 'command -v copilot >/dev/null 2>&1\n'
            ;;
        *)
            return 1
            ;;
    esac
}

run_container_shell_script() {
    local container_id="$1"
    local script="$2"
    local -a exec_args=()

    mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
    "${exec_args[@]}" sh -lc "$script"
}

command_container_tool_check() {
    local container_id
    local failures=0
    local tool
    local check_script

    load_default_tool_args container
    validate_tool_args container

    container_id="$(ensure_running)"

    for tool in "${TOOL_ARGS[@]}"; do
        check_script="$(container_has_tool_script "$tool")"
        if run_container_shell_script "$container_id" "$check_script" >/dev/null 2>&1; then
            print_success "container tool '$tool' is installed"
        else
            print_warning "container tool '$tool' is missing"
            failures=1
        fi
    done

    return $failures
}

container_package_install_script() {
    local joined_packages="$1"
    cat <<EOF
set -eu
run_as_root() {
  if [ "\$(id -u)" -eq 0 ]; then
    "\$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "\$@"
  else
    echo "devenv: need root or sudo inside the container to install packages" >&2
    exit 1
  fi
}

if command -v apt-get >/dev/null 2>&1; then
  run_as_root apt-get update
  run_as_root apt-get install -y ${joined_packages}
elif command -v dnf >/dev/null 2>&1; then
  run_as_root dnf install -y ${joined_packages}
elif command -v pacman >/dev/null 2>&1; then
  run_as_root pacman -Sy --noconfirm ${joined_packages}
elif command -v zypper >/dev/null 2>&1; then
  run_as_root zypper --non-interactive install ${joined_packages}
elif command -v apk >/dev/null 2>&1; then
  run_as_root apk add --no-cache ${joined_packages}
else
  echo "devenv: no supported package manager found in the container" >&2
  exit 1
fi
EOF
}

command_container_tool_install() {
    local container_id
    local -a package_tools=()
    local joined_packages=""
    local tool
    local script

    require_tool_args "No container tools provided. Use: devenv container-tool install <jq|tmux|helix|yazi|ranger|lf|copilot ...>"
    validate_tool_args container

    if [[ $PRINT_ONLY -eq 1 ]]; then
        for tool in "${TOOL_ARGS[@]}"; do
            case "$tool" in
                jq|tmux|helix|yazi|ranger|lf)
                    package_tools+=("$tool")
                    ;;
                copilot)
                    printf '%s\n' 'curl -fsSL https://gh.io/copilot-install | bash'
                    ;;
            esac
        done

        if [[ ${#package_tools[@]} -gt 0 ]]; then
            joined_packages="${package_tools[*]}"
            printf '%s\n' "$(container_package_install_script "$joined_packages")"
        fi
        return
    fi

    container_id="$(ensure_running)"

    for tool in "${TOOL_ARGS[@]}"; do
        case "$tool" in
            jq|tmux|helix|yazi|ranger|lf)
                package_tools+=("$tool")
                ;;
            copilot)
                run_container_shell_script "$container_id" 'curl -fsSL https://gh.io/copilot-install | bash'
                ;;
        esac
    done

    if [[ ${#package_tools[@]} -gt 0 ]]; then
        joined_packages="${package_tools[*]}"
        script="$(container_package_install_script "$joined_packages")"
        run_container_shell_script "$container_id" "$script"
    fi
}

command_host_tool() {
    case "$SUBCOMMAND" in
        list)
            host_tool_list
            ;;
        check)
            command_host_tool_check
            ;;
        install)
            command_host_tool_install
            ;;
        help|-h|--help|"")
            host_tool_help
            ;;
        *)
            die "Unknown host-tool subcommand '$SUBCOMMAND'"
            ;;
    esac
}

command_container_tool() {
    case "$SUBCOMMAND" in
        list)
            container_tool_list
            ;;
        check)
            command_container_tool_check
            ;;
        install)
            command_container_tool_install
            ;;
        help|-h|--help|"")
            container_tool_help
            ;;
        *)
            die "Unknown container-tool subcommand '$SUBCOMMAND'"
            ;;
    esac
}

install_target_path() {
    printf '%s/devenv\n' "$INSTALL_PREFIX"
}

command_install() {
    local source_path target_path

    source_path="$(self_path)"
    target_path="$(install_target_path)"

    mkdir -p "$INSTALL_PREFIX"

    if [[ -e "$target_path" && $FORCE_INSTALL -eq 0 ]]; then
        die "Install target '$target_path' already exists. Re-run with --force to replace it."
    fi

    rm -f "$target_path"

    case "$INSTALL_MODE" in
        copy)
            cp "$source_path" "$target_path"
            chmod +x "$target_path"
            ;;
        symlink)
            ln -s "$source_path" "$target_path"
            ;;
        *)
            die "Unsupported install mode '$INSTALL_MODE'. Use copy or symlink."
            ;;
    esac

    print_success "Installed devenv to $target_path"
    if ! path_contains_directory "$INSTALL_PREFIX"; then
        print_warning "Add '$INSTALL_PREFIX' to PATH to run devenv from any repo"
    fi
}

command_uninstall() {
    local target_path
    target_path="$(install_target_path)"

    if [[ ! -e "$target_path" && ! -L "$target_path" ]]; then
        die "No installed devenv found at '$target_path'"
    fi

    rm -f "$target_path"
    print_success "Removed $target_path"
}

compose() {
    (
        cd "$PROJECT_ROOT"
        docker compose -p "$PROJECT_NAME" "${COMPOSE_ARGS[@]}" "$@"
    )
}

service_container_id() {
    compose ps -q "$SERVICE_NAME" 2>/dev/null | tail -n 1
}

container_is_running() {
    local container_id="$1"

    if [[ -z "$container_id" ]]; then
        printf 'false\n'
        return
    fi

    docker inspect -f '{{if .State.Running}}true{{else}}false{{end}}' "$container_id" 2>/dev/null || printf 'false\n'
}

ensure_service_container() {
    local container_id
    container_id="$(service_container_id)"
    if [[ -z "$container_id" ]]; then
        die "Service '$SERVICE_NAME' is not available in compose project '$PROJECT_NAME'"
    fi
    printf '%s\n' "$container_id"
}

docker_exec_base() {
    local -a command=(docker exec)
    if [[ "$1" == "interactive" ]]; then
        command+=(-it)
    else
        command+=(-i)
    fi

    if [[ -n "$REMOTE_USER" ]]; then
        command+=(-u "$REMOTE_USER")
    fi

    command+=(-w "$WORKSPACE_FOLDER" "$2")
    printf '%s\0' "${command[@]}"
}

run_host_command() {
    local field="$1"
    local type
    type="$(field_type "$field")"

    case "$type" in
        missing)
            return
            ;;
        string)
            local command_string
            command_string="$(json_query_optional ".${field}")"
            if [[ -n "$command_string" ]]; then
                print_step "Running $field on the host"
                (
                    cd "$PROJECT_ROOT"
                    bash -lc "$command_string"
                )
            fi
            ;;
        array)
            local -a command_args=()
            mapfile -t command_args < <(json_query_lines ".${field}[]")
            if [[ ${#command_args[@]} -gt 0 ]]; then
                print_step "Running $field on the host"
                (
                    cd "$PROJECT_ROOT"
                    "${command_args[@]}"
                )
            fi
            ;;
        object)
            run_parallel_lifecycle_object host "$field"
            ;;
        *)
            print_warning "$field in $DEVCONTAINER_JSON uses unsupported type '$type' and was skipped"
            ;;
    esac
}

run_container_command() {
    local container_id="$1"
    local field="$2"
    local type
    type="$(field_type "$field")"

    case "$type" in
        missing)
            return
            ;;
        string)
            local command_string
            command_string="$(json_query_optional ".${field}")"
            if [[ -n "$command_string" ]]; then
                print_step "Running $field inside '$SERVICE_NAME'"
                local -a exec_args=()
                mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
                "${exec_args[@]}" sh -lc "$command_string"
            fi
            ;;
        array)
            local -a command_args=()
            local -a exec_args=()
            mapfile -t command_args < <(json_query_lines ".${field}[]")
            if [[ ${#command_args[@]} -gt 0 ]]; then
                print_step "Running $field inside '$SERVICE_NAME'"
                mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
                "${exec_args[@]}" "${command_args[@]}"
            fi
            ;;
        object)
            run_parallel_lifecycle_object container "$field" "$container_id"
            ;;
        *)
            print_warning "$field in $DEVCONTAINER_JSON uses unsupported type '$type' and was skipped"
            ;;
    esac
}

run_host_object_entry() {
    local field="$1"
    local entry_json="$2"
    local entry_name entry_type

    entry_name="$(jq -r '.key' <<< "$entry_json")"
    entry_type="$(jq -r '.value | type' <<< "$entry_json")"

    case "$entry_type" in
        string)
            local command_string
            command_string="$(jq -r '.value' <<< "$entry_json")"
            print_step "Running $field:$entry_name on the host"
            (
                cd "$PROJECT_ROOT"
                bash -lc "$command_string"
            )
            ;;
        array)
            local -a command_args=()
            mapfile -t command_args < <(jq -r '.value[]' <<< "$entry_json")
            if [[ ${#command_args[@]} -gt 0 ]]; then
                print_step "Running $field:$entry_name on the host"
                (
                    cd "$PROJECT_ROOT"
                    "${command_args[@]}"
                )
            fi
            ;;
        *)
            print_warning "$field:$entry_name uses unsupported type '$entry_type' and was skipped"
            ;;
    esac
}

run_container_object_entry() {
    local field="$1"
    local container_id="$2"
    local entry_json="$3"
    local entry_name entry_type

    entry_name="$(jq -r '.key' <<< "$entry_json")"
    entry_type="$(jq -r '.value | type' <<< "$entry_json")"

    case "$entry_type" in
        string)
            local command_string
            local -a exec_args=()
            command_string="$(jq -r '.value' <<< "$entry_json")"
            print_step "Running $field:$entry_name inside '$SERVICE_NAME'"
            mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
            "${exec_args[@]}" sh -lc "$command_string"
            ;;
        array)
            local -a command_args=()
            local -a exec_args=()
            mapfile -t command_args < <(jq -r '.value[]' <<< "$entry_json")
            if [[ ${#command_args[@]} -gt 0 ]]; then
                print_step "Running $field:$entry_name inside '$SERVICE_NAME'"
                mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
                "${exec_args[@]}" "${command_args[@]}"
            fi
            ;;
        *)
            print_warning "$field:$entry_name uses unsupported type '$entry_type' and was skipped"
            ;;
    esac
}

run_parallel_lifecycle_object() {
    local scope="$1"
    local field="$2"
    local container_id="${3:-}"
    local -a pids=()
    local -a labels=()
    local entry_json entry_name failures=0

    while IFS= read -r entry_json; do
        [[ -n "$entry_json" ]] || continue
        entry_name="$(jq -r '.key' <<< "$entry_json")"
        labels+=("$entry_name")

        if [[ "$scope" == "host" ]]; then
            run_host_object_entry "$field" "$entry_json" &
        else
            run_container_object_entry "$field" "$container_id" "$entry_json" &
        fi
        pids+=("$!")
    done < <(json_query_compact_lines ".${field} | to_entries[]")

    if [[ ${#pids[@]} -eq 0 ]]; then
        return
    fi

    for index in "${!pids[@]}"; do
        if ! wait "${pids[$index]}"; then
            print_error "$field:${labels[$index]} failed"
            failures=1
        fi
    done

    if [[ $failures -ne 0 ]]; then
        die "$field failed"
    fi
}

creation_marker_path() {
    local container_id="$1"
    printf '%s/%s.%s.done\n' "$PROJECT_STATE_DIR" "$container_id" "$2"
}

runtime_state_path() {
    printf '%s/runtime.env\n' "$PROJECT_STATE_DIR"
}

record_runtime_state() {
    local container_id="$1"

    cat > "$(runtime_state_path)" <<EOF
PROJECT_ROOT=$PROJECT_ROOT
PROJECT_NAME=$PROJECT_NAME
SERVICE_NAME=$SERVICE_NAME
CONTAINER_ID=$container_id
EOF
}

clear_runtime_state() {
    rm -f "$(runtime_state_path)"
}

prune_creation_markers() {
    local active_container_id="$1"
    local marker marker_container_id

    shopt -s nullglob
    for marker in "$PROJECT_STATE_DIR"/*.done; do
        marker_container_id="$(basename "$marker")"
        marker_container_id="${marker_container_id%%.*}"

        if [[ "$marker_container_id" == "$active_container_id" ]]; then
            continue
        fi

        if ! docker inspect "$marker_container_id" >/dev/null 2>&1; then
            rm -f "$marker"
        fi
    done
    shopt -u nullglob
}

run_creation_lifecycle() {
    local container_id="$1"
    local marker
    local field

    for field in onCreateCommand updateContentCommand postCreateCommand; do
        marker="$(creation_marker_path "$container_id" "$field")"
        if [[ ! -f "$marker" ]]; then
            run_container_command "$container_id" "$field"
            touch "$marker"
        fi
    done
}

run_start_lifecycle() {
    local container_id="$1"
    run_container_command "$container_id" postStartCommand
}

run_attach_lifecycle() {
    local container_id="$1"
    run_container_command "$container_id" postAttachCommand
}

wait_for_exec_ready() {
    local container_id="$1"
    local attempt
    local max_attempts=25
    local -a exec_args=()

    mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")

    for ((attempt = 1; attempt <= max_attempts; attempt++)); do
        if "${exec_args[@]}" sh -lc 'exit 0' >/dev/null 2>&1; then
            return
        fi

        if [[ "$(container_is_running "$container_id")" != "true" ]]; then
            die "Service '$SERVICE_NAME' stopped before it became ready for commands"
        fi

        sleep 0.2
    done

    die "Service '$SERVICE_NAME' did not become ready for commands in time"
}

start_stack() {
    local -a up_args=(up -d)
    local previous_container_id previous_running current_container_id

    previous_container_id="$(service_container_id)"
    previous_running="$(container_is_running "$previous_container_id")"

    run_host_command initializeCommand

    if [[ ${#RUN_SERVICES[@]} -gt 0 ]]; then
        up_args+=("${RUN_SERVICES[@]}")
    fi

    print_step "Starting environment '$DISPLAY_NAME'"
    compose "${up_args[@]}"

    current_container_id="$(ensure_service_container)"
    prune_creation_markers "$current_container_id"

    if [[ -z "$previous_container_id" || "$previous_container_id" != "$current_container_id" ]]; then
        run_creation_lifecycle "$current_container_id"
    fi

    if [[ -z "$previous_container_id" || "$previous_container_id" != "$current_container_id" || "$previous_running" != "true" ]]; then
        run_start_lifecycle "$current_container_id"
    fi

    record_runtime_state "$current_container_id"

    print_success "Environment is running"
}

stop_stack() {
    print_step "Stopping environment '$DISPLAY_NAME'"
    if compose down --remove-orphans; then
        clear_runtime_state
        print_success "Environment stopped"
    else
        print_warning "Compose reported an error while stopping the environment"
    fi
}

open_shell() {
    local container_id="$1"
    local shell_script='if command -v bash >/dev/null 2>&1; then exec bash -l; elif command -v sh >/dev/null 2>&1; then exec sh -l; else exec /bin/sh; fi'
    local -a exec_args=()

    run_attach_lifecycle "$container_id"
    mapfile -d '' -t exec_args < <(docker_exec_base interactive "$container_id")
    "${exec_args[@]}" sh -lc "$shell_script"
}

ensure_running() {
    local container_id
    container_id="$(service_container_id)"
    if [[ -z "$container_id" || "$(container_is_running "$container_id")" != "true" ]]; then
        start_stack
        container_id="$(ensure_service_container)"
    fi
    wait_for_exec_ready "$container_id"
    printf '%s\n' "$container_id"
}

command_open() {
    local container_id
    local exit_code=0

    container_id="$(ensure_running)"
    print_step "Opening shell in service '$SERVICE_NAME'"
    if [[ $REMOVE_ON_EXIT -eq 1 ]]; then
        print_warning "Services will stop when this shell exits"
    fi

    open_shell "$container_id" || exit_code=$?

    if [[ $REMOVE_ON_EXIT -eq 1 ]]; then
        stop_stack
    fi

    return $exit_code
}

command_up() {
    start_stack
}

command_down() {
    stop_stack
}

command_shell() {
    local container_id
    local exit_code=0

    container_id="$(ensure_running)"
    print_step "Opening shell in service '$SERVICE_NAME'"
    open_shell "$container_id" || exit_code=$?

    if [[ $REMOVE_ON_EXIT -eq 1 ]]; then
        stop_stack
    fi

    return $exit_code
}

command_exec() {
    local container_id
    local -a exec_args=()
    local -a command_args=("$@")
    local exit_code=0

    [[ ${#command_args[@]} -gt 0 ]] || die "No command provided. Use: devenv exec -- <command> [args...]"

    container_id="$(ensure_running)"
    mapfile -d '' -t exec_args < <(docker_exec_base non-interactive "$container_id")
    "${exec_args[@]}" "${command_args[@]}" || exit_code=$?

    if [[ $REMOVE_ON_EXIT -eq 1 ]]; then
        stop_stack
    fi

    return $exit_code
}

tool_help() {
    cat <<'EOF'
Available tools:
  helix  Launch Helix (`hx`) in the workspace.
  tmux   Create or attach to a tmux session named `devenv`.
  files  Launch a terminal file browser, or fall back to a directory listing.

Examples:
  devenv tool helix
  devenv tool helix -- src/index.js
  devenv tool tmux
  devenv tool files
EOF
}

command_tool() {
    local container_id
    local -a exec_args=()
    local -a tool_args=("${EXEC_ARGS[@]}")
    local tool_script=""
    local exit_code=0

    [[ -n "$TOOL_NAME" ]] || die "No tool provided. Use: devenv tool <helix|tmux|files> [-- args...]"

    case "$TOOL_NAME" in
        helix)
            tool_script='if ! command -v hx >/dev/null 2>&1; then echo "devenv: tool '\''helix'\'' requires `hx` in the container image. Install Helix in this repo\''s devcontainer." >&2; exit 127; fi; if [[ $# -eq 0 ]]; then set -- .; fi; exec hx "$@"'
            ;;
        tmux)
            tool_script='if ! command -v tmux >/dev/null 2>&1; then echo "devenv: tool '\''tmux'\'' requires `tmux` in the container image. Install tmux in this repo\''s devcontainer." >&2; exit 127; fi; if [[ $# -eq 0 ]]; then if tmux has-session -t devenv 2>/dev/null; then exec tmux attach -t devenv; else exec tmux new -s devenv; fi; fi; exec tmux "$@"'
            ;;
        files)
            tool_script='if [[ $# -eq 0 ]]; then set -- .; fi; if command -v yazi >/dev/null 2>&1; then exec yazi "$@"; fi; if command -v ranger >/dev/null 2>&1; then exec ranger "$@"; fi; if command -v lf >/dev/null 2>&1; then exec lf "$@"; fi; if command -v eza >/dev/null 2>&1; then exec eza -la --group-directories-first "$@"; fi; exec ls -la "$@"'
            ;;
        help|-h|--help)
            tool_help
            return 0
            ;;
        *)
            die "Unknown tool '$TOOL_NAME'. Use: devenv tool <helix|tmux|files>"
            ;;
    esac

    container_id="$(ensure_running)"
    print_step "Opening tool '$TOOL_NAME' in service '$SERVICE_NAME'"
    run_attach_lifecycle "$container_id"
    mapfile -d '' -t exec_args < <(docker_exec_base interactive "$container_id")
    "${exec_args[@]}" sh -lc "$tool_script" sh "${tool_args[@]}" || exit_code=$?

    if [[ $REMOVE_ON_EXIT -eq 1 ]]; then
        stop_stack
    fi

    return $exit_code
}

command_host_tmux() {
    local session_name launcher_path shell_command

    require_command tmux "Install tmux on the host to use host-tmux sessions."

    session_name="$PROJECT_NAME"
    launcher_path="$(self_path)"
    shell_command="$(shell_escape "$launcher_path") shell --workspace $(shell_escape "$PROJECT_ROOT") --project-name $(shell_escape "$PROJECT_NAME")"

    if [[ -n "$SERVICE_OVERRIDE" ]]; then
        shell_command+=" --service $(shell_escape "$SERVICE_OVERRIDE")"
    fi

    if tmux has-session -t "$session_name" >/dev/null 2>&1; then
        print_step "Attaching host tmux session '$session_name'"
        tmux attach-session -t "$session_name"
        return
    fi

    print_step "Creating host tmux session '$session_name'"
    tmux new-session -d -s "$session_name" -c "$PROJECT_ROOT" "$shell_command"
    tmux rename-window -t "${session_name}:1" shell >/dev/null 2>&1 || true
    tmux attach-session -t "$session_name"
}

command_logs() {
    if [[ -n "$SERVICE_OVERRIDE" ]]; then
        compose logs "$SERVICE_OVERRIDE"
    else
        compose logs
    fi
}

command_ps() {
    compose ps
}

command_config() {
    cat <<EOF
Workspace root:   $PROJECT_ROOT
Config file:      $DEVCONTAINER_JSON
Scenario:         $SCENARIO
Display name:     $DISPLAY_NAME
Project name:     $PROJECT_NAME
Primary service:  $SERVICE_NAME
Remote user:      ${REMOTE_USER:-<container default>}
Workspace folder: $WORKSPACE_FOLDER
Compose files:
$(printf '  - %s\n' "${COMPOSE_FILES[@]}")
EOF
}

command_check() {
    require_compose
    emit_spec_warnings
    print_success "Host prerequisites are available"
    command_config
}

parse_args() {
    COMMAND="open"
    EXEC_ARGS=()
    TOOL_NAME=""
    SUBCOMMAND=""
    TOOL_ARGS=()
    PRINT_ONLY=0
    local explicit_command=0

    if [[ $# -gt 0 ]]; then
        case "$1" in
            open|up|down|shell|exec|tool|host-tool|container-tool|host-tmux|logs|ps|config|check|install|uninstall|help)
                COMMAND="$1"
                explicit_command=1
                shift
                ;;
            -h|--help)
                COMMAND="help"
                shift
                ;;
        esac
    fi

    if [[ "$COMMAND" == "open" && $explicit_command -eq 1 && $# -gt 0 && "$1" != -* ]]; then
        PROJECT_NAME_OVERRIDE="$1"
        shift
    fi

    if [[ "$COMMAND" == "tool" && $# -gt 0 && "$1" != -* ]]; then
        TOOL_NAME="$1"
        shift
    fi

    if [[ ( "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ) && $# -gt 0 && "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace|-w)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                WORKSPACE_HINT="$2"
                shift 2
                ;;
            --project-name|-p)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                PROJECT_NAME_OVERRIDE="$2"
                shift 2
                ;;
            --service|-s)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                SERVICE_OVERRIDE="$2"
                shift 2
                ;;
            --prefix)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                INSTALL_PREFIX="$2"
                shift 2
                ;;
            --mode)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                INSTALL_MODE="$2"
                shift 2
                ;;
            --force)
                FORCE_INSTALL=1
                shift
                ;;
            --rm)
                REMOVE_ON_EXIT=1
                shift
                ;;
            --print)
                PRINT_ONLY=1
                shift
                ;;
            --help|-h)
                if [[ "$COMMAND" == "tool" ]]; then
                    TOOL_NAME="help"
                    shift
                elif [[ "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ]]; then
                    SUBCOMMAND="help"
                    shift
                else
                    COMMAND="help"
                    shift
                fi
                ;;
            --)
                shift
                EXEC_ARGS=("$@")
                break
                ;;
            *)
                if [[ "$COMMAND" == "exec" ]]; then
                    EXEC_ARGS=("$@")
                    break
                fi

                if [[ "$COMMAND" == "tool" ]]; then
                    if [[ -z "$TOOL_NAME" ]]; then
                        TOOL_NAME="$1"
                        shift
                        continue
                    fi
                    EXEC_ARGS=("$@")
                    break
                fi

                if [[ "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ]]; then
                    TOOL_ARGS+=("$1")
                    shift
                    continue
                fi

                if [[ "$COMMAND" == "logs" && -z "$SERVICE_OVERRIDE" ]]; then
                    SERVICE_OVERRIDE="$1"
                    shift
                    continue
                fi

                if [[ "$COMMAND" == "open" && $explicit_command -eq 0 ]]; then
                    die "Unknown argument: $1"
                fi

                die "Unknown argument: $1"
                ;;
        esac
    done
}

main() {
    parse_args "$@"

    case "$COMMAND" in
        help)
            usage
            return 0
            ;;
        tool)
            if [[ -z "$TOOL_NAME" || "$TOOL_NAME" == "help" || "$TOOL_NAME" == "-h" || "$TOOL_NAME" == "--help" ]]; then
                tool_help
                return 0
            fi
            ;;
        host-tool)
            command_host_tool
            return 0
            ;;
        container-tool)
            if [[ "$SUBCOMMAND" == "help" || -z "$SUBCOMMAND" ]]; then
                command_container_tool
                return 0
            fi
            ;;
        host-tmux)
            ;;
        install)
            command_install
            return 0
            ;;
        uninstall)
            command_uninstall
            return 0
            ;;
    esac

    load_workspace_context

    case "$COMMAND" in
        config)
            command_config
            ;;
        check)
            command_check
            ;;
        up|down|shell|exec|tool|container-tool|host-tmux|logs|ps|open)
            require_compose
            emit_spec_warnings
            case "$COMMAND" in
                open)
                    command_open
                    ;;
                up)
                    command_up
                    ;;
                down)
                    command_down
                    ;;
                shell)
                    command_shell
                    ;;
                exec)
                    command_exec "${EXEC_ARGS[@]}"
                    ;;
                tool)
                    command_tool
                    ;;
                container-tool)
                    command_container_tool
                    ;;
                host-tmux)
                    command_host_tmux
                    ;;
                logs)
                    command_logs
                    ;;
                ps)
                    command_ps
                    ;;
            esac
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
