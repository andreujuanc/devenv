command_status() {
    local overall_status="healthy"
    local primary_label="$SERVICE_NAME"
    local label container_id state health ready
    local candidate existing found
    local -a expected_targets=()
    local -a observed_targets=()
    local -a targets=()
    local -a details=()

    if [[ "$SCENARIO" == "compose" ]]; then
        mapfile -t expected_targets < <(compose_expected_services)
        mapfile -t observed_targets < <(compose_project_services)
        for candidate in "${expected_targets[@]}" "${observed_targets[@]}"; do
            [[ -n "$candidate" ]] || continue
            found=0
            for existing in "${targets[@]}"; do
                if [[ "$existing" == "$candidate" ]]; then
                    found=1
                    break
                fi
            done
            if [[ $found -eq 0 ]]; then
                targets+=("$candidate")
            fi
        done
    else
        targets=("$CONTAINER_NAME")
        primary_label="$CONTAINER_NAME"
    fi

    if [[ ${#targets[@]} -eq 0 ]]; then
        die "Could not determine which containers belong to this environment"
    fi

    printf 'Scenario: %s\n' "$SCENARIO"
    printf 'Project: %s\n' "$PROJECT_NAME"
    printf 'Primary: %s\n' "$primary_label"
    printf 'Checks:\n'

    for label in "${targets[@]}"; do
        if [[ "$SCENARIO" == "compose" ]]; then
            container_id="$(compose_service_container_id "$label")"
        else
            container_id="$(service_container_id)"
        fi

        state="$(container_state_status "$container_id")"
        health="$(container_health_status "$container_id")"
        details=()

        if [[ -z "$container_id" ]]; then
            overall_status="unhealthy"
            details+=("missing")
        else
            details+=("state=$state")

            if [[ "$state" != "running" ]]; then
                overall_status="unhealthy"
            fi

            if [[ "$health" != "none" ]]; then
                details+=("health=$health")
                if [[ "$health" != "healthy" ]]; then
                    overall_status="unhealthy"
                fi
            fi

            if [[ "$label" == "$SERVICE_NAME" || "$label" == "$CONTAINER_NAME" ]]; then
                if [[ "$state" == "running" ]]; then
                    if container_exec_ready "$container_id"; then
                        ready="ready"
                    else
                        ready="not-ready"
                        overall_status="unhealthy"
                    fi
                else
                    ready="not-ready"
                fi
                details+=("$ready")
            fi
        fi

        printf '  - %s: %s\n' "$label" "$(IFS=', '; printf '%s' "${details[*]}")"
    done

    printf 'Status: %s\n' "$overall_status"

    if [[ "$overall_status" == "healthy" ]]; then
        print_success "Environment is healthy"
        return 0
    fi

    print_error "Environment is unhealthy"
    return 1
}

