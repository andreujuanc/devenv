require_command() {
    local command_name="$1"
    local hint="$2"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "Required command '$command_name' not found. $hint"
    fi
}

jsonc_to_json() {
    awk -f "$(require_script_asset "scripts/jsonc-to-json.awk")" "$1"
}

ensure_devcontainer_cache() {
    if [[ -n "$DEVCONTAINER_CACHE" && -f "$DEVCONTAINER_CACHE" ]]; then
        return
    fi

    [[ -n "$DEVCONTAINER_JSON" ]] || die "Internal error: devcontainer path not initialized"

    DEVCONTAINER_CACHE="$(mktemp)"
    jsonc_to_json "$DEVCONTAINER_JSON" > "$DEVCONTAINER_CACHE"

    if ! jq empty "$DEVCONTAINER_CACHE" >/dev/null 2>&1; then
        die "Failed to parse $DEVCONTAINER_JSON. Ensure it contains valid JSON or JSONC."
    fi
}

json_query_optional() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -er "$filter // empty" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

json_query_required() {
    local filter="$1"
    local description="$2"
    local value

    value="$(json_query_optional "$filter")"
    if [[ -z "$value" ]]; then
        die "Required field '$description' not found in $DEVCONTAINER_JSON"
    fi

    printf '%s\n' "$value"
}

json_has_value() {
    local field="$1"
    ensure_devcontainer_cache
    jq -e --arg field "$field" 'has($field) and .[$field] != null' "$DEVCONTAINER_CACHE" >/dev/null 2>&1
}

json_query_lines() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -r "$filter" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

json_query_compact_lines() {
    local filter="$1"
    ensure_devcontainer_cache
    jq -c "$filter" "$DEVCONTAINER_CACHE" 2>/dev/null || true
}

devcontainer_has_explicit_ssh_agent_config() {
    ensure_devcontainer_cache
    jq -e '
        ((.remoteEnv // {}) | has("SSH_AUTH_SOCK")) or
        ((.containerEnv // {}) | has("SSH_AUTH_SOCK")) or
        (((.mounts // []) | map(tostring | test("SSH_AUTH_SOCK|ssh-agent"; "i")) | any) // false)
    ' "$DEVCONTAINER_CACHE" >/dev/null 2>&1
}

devcontainer_has_explicit_host_dir_config() {
    local path_fragment="$1"
    ensure_devcontainer_cache
    jq -e --arg path_fragment "${path_fragment,,}" '
        (((.mounts // []) | map(tostring | ascii_downcase | contains($path_fragment)) | any) // false)
    ' "$DEVCONTAINER_CACHE" >/dev/null 2>&1
}

yaml_single_quote() {
    printf "%s" "$1" | sed "s/'/''/g"
}

container_home_dir() {
    if [[ -z "$REMOTE_USER" || "$REMOTE_USER" == "root" ]]; then
        printf '/root\n'
        return
    fi

    printf '/home/%s\n' "$REMOTE_USER"
}

mount_spec_value() {
    local mount_spec="$1"
    local key_name="$2"
    local segment key value

    IFS=',' read -r -a mount_segments <<< "$mount_spec"
    for segment in "${mount_segments[@]}"; do
        key="${segment%%=*}"
        value="${segment#*=}"
        key="${key## }"
        key="${key%% }"
        if [[ "$key" == "$key_name" ]]; then
            printf '%s\n' "$value"
            return 0
        fi
    done

    return 1
}

should_skip_mount_spec() {
    local mount_spec="$1"
    local mount_type mount_source

    mount_type="$(mount_spec_value "$mount_spec" type || true)"
    mount_source="$(mount_spec_value "$mount_spec" source || mount_spec_value "$mount_spec" src || true)"

    if [[ "$mount_type" != "bind" || -z "$mount_source" ]]; then
        return 1
    fi

    if [[ -e "$mount_source" || -S "$mount_source" ]]; then
        return 1
    fi

    print_warning "Skipping bind mount because the source path does not exist on the host: $mount_source"
    return 0
}

expand_devcontainer_value() {
    local value="$1"
    local prefix variable_name has_default default_value suffix replacement

    value="${value//\$\{localWorkspaceFolder\}/$PROJECT_ROOT}"
    value="${value//\$\{localWorkspaceFolderBasename\}/$(basename "$PROJECT_ROOT")}"
    value="${value//\$\{containerWorkspaceFolder\}/$WORKSPACE_FOLDER}"

    while [[ "$value" =~ (.*)\$\{localEnv:([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*) ]]; do
        prefix="${BASH_REMATCH[1]}"
        variable_name="${BASH_REMATCH[2]}"
        has_default="${BASH_REMATCH[3]:-}"
        default_value="${BASH_REMATCH[4]:-}"
        suffix="${BASH_REMATCH[5]}"

        if [[ -n "$has_default" ]]; then
            replacement="${!variable_name:-$default_value}"
        else
            replacement="${!variable_name-}"
        fi

        value="${prefix}${replacement}${suffix}"
    done

    printf '%s\n' "$value"
}

container_env_value() {
    local container_id="$1"
    local variable_name="$2"
    local env_line env_key env_value

    while IFS= read -r env_line; do
        [[ -n "$env_line" ]] || continue
        env_key="${env_line%%=*}"
        env_value="${env_line#*=}"
        if [[ "$env_key" == "$variable_name" ]]; then
            printf '%s\n' "$env_value"
            return 0
        fi
    done < <(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container_id" 2>/dev/null || true)

    return 1
}

expand_remote_env_value() {
    local value="$1"
    local container_id="$2"
    local prefix variable_name has_default default_value suffix replacement

    value="$(expand_devcontainer_value "$value")"

    while [[ "$value" =~ (.*)\$\{containerEnv:([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*) ]]; do
        prefix="${BASH_REMATCH[1]}"
        variable_name="${BASH_REMATCH[2]}"
        has_default="${BASH_REMATCH[3]:-}"
        default_value="${BASH_REMATCH[4]:-}"
        suffix="${BASH_REMATCH[5]}"

        if replacement="$(container_env_value "$container_id" "$variable_name")"; then
            :
        elif [[ -n "$has_default" ]]; then
            replacement="$default_value"
        else
            replacement=""
        fi

        value="${prefix}${replacement}${suffix}"
    done

    printf '%s\n' "$value"
}

image_env_value() {
    local image_name="$1"
    local variable_name="$2"
    local env_line env_key env_value

    while IFS= read -r env_line; do
        [[ -n "$env_line" ]] || continue
        env_key="${env_line%%=*}"
        env_value="${env_line#*=}"
        if [[ "$env_key" == "$variable_name" ]]; then
            printf '%s\n' "$env_value"
            return 0
        fi
    done < <(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$image_name" 2>/dev/null || true)

    return 1
}

expand_container_env_value() {
    local value="$1"
    local image_name="$2"
    local prefix variable_name has_default default_value suffix replacement

    value="$(expand_devcontainer_value "$value")"

    while [[ "$value" =~ (.*)\$\{containerEnv:([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*) ]]; do
        prefix="${BASH_REMATCH[1]}"
        variable_name="${BASH_REMATCH[2]}"
        has_default="${BASH_REMATCH[3]:-}"
        default_value="${BASH_REMATCH[4]:-}"
        suffix="${BASH_REMATCH[5]}"

        if replacement="$(image_env_value "$image_name" "$variable_name")"; then
            :
        elif [[ -n "$has_default" ]]; then
            replacement="$default_value"
        else
            replacement=""
        fi

        value="${prefix}${replacement}${suffix}"
    done

    printf '%s\n' "$value"
}

load_container_env_args_for_image() {
    local image_name="$1"
    local env_entry env_key env_value

    CONTAINER_ENV_ARGS=()
    while IFS= read -r env_entry; do
        [[ -n "$env_entry" ]] || continue
        env_key="$(jq -r '.key' <<< "$env_entry")"
        env_value="$(jq -r '.value|tostring' <<< "$env_entry")"
        env_value="$(expand_container_env_value "$env_value" "$image_name")"
        CONTAINER_ENV_ARGS+=(-e "$env_key=$env_value")
    done < <(json_query_compact_lines '(.containerEnv // {}) | to_entries[]')
}

remote_env_args_for_container() {
    local container_id="$1"
    local entry key value

    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        key="$(jq -r '.key' <<< "$entry")"
        value="$(jq -r '.value|tostring' <<< "$entry")"
        value="$(expand_remote_env_value "$value" "$container_id")"
        printf '%s\0' -e "$key=$value"
    done < <(json_query_compact_lines '(.remoteEnv // {}) | to_entries[]')

    if [[ $AUTO_SSH_AGENT_FORWARDING -eq 1 ]]; then
        printf '%s\0' -e "SSH_AUTH_SOCK=$AUTO_SSH_AGENT_TARGET"
    fi
}

load_forward_ports() {
    local port_entry target_name target_port

    FORWARD_PORTS=()
    while IFS= read -r port_entry; do
        [[ -n "$port_entry" ]] || continue

        if [[ "$port_entry" =~ ^[0-9]+$ ]]; then
            FORWARD_PORTS+=("$port_entry")
            continue
        fi

        if [[ "$port_entry" =~ ^([^:]+):([0-9]+)$ ]]; then
            target_name="${BASH_REMATCH[1]}"
            target_port="${BASH_REMATCH[2]}"
            if [[ "$target_name" == "$SERVICE_NAME" ]]; then
                FORWARD_PORTS+=("$target_port")
            else
                print_warning "Skipping forwardPorts entry '$port_entry' because it targets '$target_name'. devenv currently publishes ports only for the primary service '$SERVICE_NAME'."
            fi
            continue
        fi

        print_warning "Skipping unsupported forwardPorts entry '$port_entry'. devenv currently supports numeric ports and '<service>:<port>' for the primary service."
    done < <(json_query_lines '.forwardPorts // [] | if type == "array" then .[] else . end | tostring')
}

write_compose_runtime_override() {
    local quoted_service quoted_source quoted_target port index

    if [[ "$SCENARIO" != "compose" ]]; then
        return
    fi

    if [[ $AUTO_SSH_AGENT_FORWARDING -eq 0 && ${#FORWARD_PORTS[@]} -eq 0 && ${#AUTO_HOST_MOUNT_SOURCES[@]} -eq 0 ]]; then
        return
    fi

    quoted_service="$(yaml_single_quote "$SERVICE_NAME")"
    COMPOSE_RUNTIME_OVERRIDE="$PROJECT_STATE_DIR/compose.runtime.override.yml"

    {
        printf 'services:\n'
        printf "  '%s':\n" "$quoted_service"

        if [[ $AUTO_SSH_AGENT_FORWARDING -eq 1 ]]; then
            quoted_target="$(yaml_single_quote "$AUTO_SSH_AGENT_TARGET")"
            printf '    environment:\n'
            printf "      SSH_AUTH_SOCK: '%s'\n" "$quoted_target"
        fi

        if [[ $AUTO_SSH_AGENT_FORWARDING -eq 1 || ${#AUTO_HOST_MOUNT_SOURCES[@]} -gt 0 ]]; then
            printf '    volumes:\n'
        fi

        if [[ $AUTO_SSH_AGENT_FORWARDING -eq 1 ]]; then
            quoted_source="$(yaml_single_quote "$AUTO_SSH_AGENT_SOURCE")"
            quoted_target="$(yaml_single_quote "$AUTO_SSH_AGENT_TARGET")"
            printf '      - type: bind\n'
            printf "        source: '%s'\n" "$quoted_source"
            printf "        target: '%s'\n" "$quoted_target"
            printf '        read_only: true\n'
        fi

        if [[ ${#AUTO_HOST_MOUNT_SOURCES[@]} -gt 0 ]]; then
            for index in "${!AUTO_HOST_MOUNT_SOURCES[@]}"; do
                quoted_source="$(yaml_single_quote "${AUTO_HOST_MOUNT_SOURCES[$index]}")"
                quoted_target="$(yaml_single_quote "${AUTO_HOST_MOUNT_TARGETS[$index]}")"
                printf '      - type: bind\n'
                printf "        source: '%s'\n" "$quoted_source"
                printf "        target: '%s'\n" "$quoted_target"
            done
        fi

        if [[ ${#FORWARD_PORTS[@]} -gt 0 ]]; then
            printf '    ports:\n'
            for port in "${FORWARD_PORTS[@]}"; do
                printf "      - '127.0.0.1:%s:%s'\n" "$port" "$port"
            done
        fi
    } > "$COMPOSE_RUNTIME_OVERRIDE"

    COMPOSE_ARGS+=(-f "$COMPOSE_RUNTIME_OVERRIDE")
}

configure_forward_ports() {
    local port

    PORT_ARGS=()
    if [[ ${#FORWARD_PORTS[@]} -eq 0 ]]; then
        return
    fi

    if [[ "$SCENARIO" == "dockerfile" ]]; then
        for port in "${FORWARD_PORTS[@]}"; do
            PORT_ARGS+=(-p "127.0.0.1:${port}:${port}")
        done
    fi
}

configure_automatic_ssh_agent_forwarding() {
    AUTO_SSH_AGENT_FORWARDING=0
    AUTO_SSH_AGENT_SOURCE=""
    COMPOSE_RUNTIME_OVERRIDE=""

    if [[ "${DEVENV_NO_SSH_AGENT_FORWARDING:-0}" == "1" ]]; then
        return
    fi

    if [[ -z "${SSH_AUTH_SOCK:-}" || ! -S "${SSH_AUTH_SOCK:-}" ]]; then
        return
    fi

    if devcontainer_has_explicit_ssh_agent_config; then
        return
    fi

    AUTO_SSH_AGENT_FORWARDING=1
    AUTO_SSH_AGENT_SOURCE="$SSH_AUTH_SOCK"

        if [[ "$SCENARIO" == "dockerfile" ]]; then
        MOUNT_ARGS+=("--mount=type=bind,source=$AUTO_SSH_AGENT_SOURCE,target=$AUTO_SSH_AGENT_TARGET,readonly")
    fi
}

    configure_automatic_host_dir_mounts() {
        local container_home host_dir rel_path target_dir

        AUTO_HOST_DOTDIR_MOUNTING=0
        AUTO_HOST_MOUNT_SOURCES=()
        AUTO_HOST_MOUNT_TARGETS=()

        if [[ "${DEVENV_NO_HOST_DOTDIR_FORWARDING:-0}" == "1" ]]; then
            return
        fi

        container_home="$(container_home_dir)"

        for rel_path in .copilot .gemini .opencode .local/share/opencode; do
            host_dir="$HOME/$rel_path"
            target_dir="$container_home/$rel_path"

            if [[ ! -d "$host_dir" ]]; then
                continue
            fi

            if devcontainer_has_explicit_host_dir_config "$rel_path"; then
                continue
            fi

            AUTO_HOST_DOTDIR_MOUNTING=1
            AUTO_HOST_MOUNT_SOURCES+=("$host_dir")
            AUTO_HOST_MOUNT_TARGETS+=("$target_dir")

            if [[ "$SCENARIO" == "dockerfile" ]]; then
                MOUNT_ARGS+=("--mount=type=bind,source=$host_dir,target=$target_dir")
            fi
        done
    }

field_type() {
    local field="$1"
    ensure_devcontainer_cache
    jq -r --arg field "$field" 'if has($field) and .[$field] != null then (.[$field] | type) else "missing" end' "$DEVCONTAINER_CACHE"
}

absolute_directory_path() {
    (
        cd "$1" >/dev/null 2>&1 && pwd -P
    )
}

absolute_file_path() {
    local directory_path
    directory_path="$(absolute_directory_path "$(dirname "$1")")"
    printf '%s/%s\n' "$directory_path" "$(basename "$1")"
}

resolve_workspace_start() {
    if [[ -z "$WORKSPACE_HINT" ]]; then
        pwd -P
        return
    fi

    if [[ -d "$WORKSPACE_HINT" ]]; then
        absolute_directory_path "$WORKSPACE_HINT"
        return
    fi

    if [[ -f "$WORKSPACE_HINT" ]]; then
        absolute_file_path "$WORKSPACE_HINT"
        return
    fi

    die "Workspace path '$WORKSPACE_HINT' does not exist"
}

discover_workspace() {
    local start_path current_path
    start_path="$(resolve_workspace_start)"

    if [[ -f "$start_path" ]]; then
        DEVCONTAINER_JSON="$start_path"
        if [[ "$(basename "$DEVCONTAINER_JSON")" == "devcontainer.json" ]]; then
            PROJECT_ROOT="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")/..")"
        else
            PROJECT_ROOT="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")")"
        fi
        DEVCONTAINER_DIR="$(absolute_directory_path "$(dirname "$DEVCONTAINER_JSON")")"
        return
    fi

    current_path="$start_path"
    while [[ "$current_path" != "/" ]]; do
        if [[ -f "$current_path/$DEFAULT_DEVCONTAINER_JSON" ]]; then
            PROJECT_ROOT="$current_path"
            DEVCONTAINER_JSON="$current_path/$DEFAULT_DEVCONTAINER_JSON"
            DEVCONTAINER_DIR="$current_path/.devcontainer"
            return
        fi

        if [[ -f "$current_path/$FALLBACK_DEVCONTAINER_JSON" ]]; then
            PROJECT_ROOT="$current_path"
            DEVCONTAINER_JSON="$current_path/$FALLBACK_DEVCONTAINER_JSON"
            DEVCONTAINER_DIR="$current_path"
            return
        fi

        current_path="$(dirname "$current_path")"
    done

    die "Could not find $DEFAULT_DEVCONTAINER_JSON or $FALLBACK_DEVCONTAINER_JSON from the current directory"
}

sanitize_identifier() {
    local value="$1"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    if [[ -z "$value" ]]; then
        value="workspace"
    fi
    printf '%s\n' "$value"
}

derive_project_hash() {
    printf '%s' "$PROJECT_ROOT" | cksum | awk '{print $1}'
}

build_project_name() {
    local base_name

    if [[ -n "$PROJECT_NAME_OVERRIDE" ]]; then
        printf '%s\n' "$(sanitize_identifier "$PROJECT_NAME_OVERRIDE")"
        return
    fi

    base_name="$(sanitize_identifier "$(basename "$PROJECT_ROOT")")"
    printf '%s-%s\n' "$base_name" "$PROJECT_HASH"
}

resolve_compose_files() {
    local compose_entry resolved_path

    mapfile -t COMPOSE_FILES < <(json_query_lines '.dockerComposeFile | if type == "array" then .[] else . end')
    if [[ ${#COMPOSE_FILES[@]} -eq 0 ]]; then
        die "The current v1 implementation requires dockerComposeFile in $DEVCONTAINER_JSON"
    fi

    COMPOSE_ARGS=()
    for compose_entry in "${COMPOSE_FILES[@]}"; do
        if [[ "$compose_entry" = /* ]]; then
            resolved_path="$compose_entry"
        else
            resolved_path="$DEVCONTAINER_DIR/$compose_entry"
        fi

        resolved_path="$(absolute_file_path "$resolved_path")"
        [[ -f "$resolved_path" ]] || die "Compose file '$resolved_path' does not exist"

        COMPOSE_ARGS+=(-f "$resolved_path")
    done
}

resolve_dockerfile_settings() {
    local dockerfile_entry context_entry resolved_path run_arg mount_spec env_entry env_key env_value

    dockerfile_entry="$(json_query_optional '.dockerFile // .build.dockerfile')"
    [[ -n "$dockerfile_entry" ]] || die "The devcontainer configuration is missing dockerFile/build.dockerfile in $DEVCONTAINER_JSON"

    if [[ "$dockerfile_entry" = /* ]]; then
        resolved_path="$dockerfile_entry"
    else
        resolved_path="$DEVCONTAINER_DIR/$dockerfile_entry"
    fi
    DOCKERFILE_PATH="$(absolute_file_path "$resolved_path")"
    [[ -f "$DOCKERFILE_PATH" ]] || die "Dockerfile '$DOCKERFILE_PATH' does not exist"

    context_entry="$(json_query_optional '.context // .build.context')"
    if [[ -z "$context_entry" ]]; then
        context_entry="."
    fi

    if [[ "$context_entry" = /* ]]; then
        resolved_path="$context_entry"
    else
        resolved_path="$DEVCONTAINER_DIR/$context_entry"
    fi
    BUILD_CONTEXT_PATH="$(absolute_directory_path "$resolved_path")"
    [[ -d "$BUILD_CONTEXT_PATH" ]] || die "Build context '$BUILD_CONTEXT_PATH' does not exist"

    BUILD_ARGS=()
    while IFS= read -r env_entry; do
        [[ -n "$env_entry" ]] || continue
        env_key="$(jq -r '.key' <<< "$env_entry")"
        env_value="$(jq -r '.value|tostring' <<< "$env_entry")"
        env_value="$(expand_devcontainer_value "$env_value")"
        BUILD_ARGS+=("--build-arg=${env_key}=${env_value}")
    done < <(json_query_compact_lines '(.args // .build.args // {}) | to_entries[]')

    RUN_ARGS=()
    while IFS= read -r run_arg; do
        [[ -n "$run_arg" ]] || continue
        RUN_ARGS+=("$(expand_devcontainer_value "$run_arg")")
    done < <(json_query_lines '.runArgs // [] | .[]')

    CONTAINER_ENV_ARGS=()

    MOUNT_ARGS=()
    while IFS= read -r mount_spec; do
        [[ -n "$mount_spec" ]] || continue
        mount_spec="$(expand_devcontainer_value "$mount_spec")"
        if should_skip_mount_spec "$mount_spec"; then
            continue
        fi
        MOUNT_ARGS+=("--mount=$mount_spec")
    done < <(json_query_lines '.mounts // [] | .[]')
}

load_run_services() {
    mapfile -t RUN_SERVICES < <(json_query_lines '.runServices // [] | .[]')

    if [[ ${#RUN_SERVICES[@]} -gt 0 ]]; then
        local found=0
        local run_service
        for run_service in "${RUN_SERVICES[@]}"; do
            if [[ "$run_service" == "$SERVICE_NAME" ]]; then
                found=1
                break
            fi
        done

        if [[ $found -eq 0 ]]; then
            RUN_SERVICES+=("$SERVICE_NAME")
        fi
    fi
}

load_workspace_context() {
    discover_workspace
    require_command jq "Install jq to parse devcontainer.json files."
    ensure_devcontainer_cache

    if json_has_value "dockerComposeFile"; then
        SCENARIO="compose"
    elif [[ -n "$(json_query_optional '.dockerFile // .build.dockerfile')" ]]; then
        SCENARIO="dockerfile"
    else
        die "Unsupported devcontainer configuration in $DEVCONTAINER_JSON. v1 currently supports dockerComposeFile-based repos and Dockerfile-based repos."
    fi

    DISPLAY_NAME="$(json_query_optional '.name')"
    if [[ -z "$DISPLAY_NAME" ]]; then
        DISPLAY_NAME="$(basename "$PROJECT_ROOT")"
    fi

    if [[ "$SCENARIO" == "compose" ]]; then
        SERVICE_NAME="$(json_query_required '.service' 'service')"
        if [[ -n "$SERVICE_OVERRIDE" ]]; then
            SERVICE_NAME="$SERVICE_OVERRIDE"
        fi
    else
        SERVICE_NAME="${SERVICE_OVERRIDE:-container}"
    fi

    WORKSPACE_FOLDER="$(json_query_optional '.workspaceFolder')"
    if [[ -z "$WORKSPACE_FOLDER" ]]; then
        WORKSPACE_FOLDER="/workspaces/$(basename "$PROJECT_ROOT")"
    fi

    REMOTE_USER="$(json_query_optional '.remoteUser // .containerUser')"
    PROJECT_HASH="$(derive_project_hash)"
    PROJECT_NAME="$(build_project_name)"
    PROJECT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devenv/$PROJECT_HASH"
    mkdir -p "$PROJECT_STATE_DIR"
    load_forward_ports

    if [[ "$SCENARIO" == "compose" ]]; then
        resolve_compose_files
        load_run_services
    else
        IMAGE_NAME="$PROJECT_NAME-devcontainer:latest"
        CONTAINER_NAME="$PROJECT_NAME-devcontainer"
        resolve_dockerfile_settings
    fi

    configure_automatic_ssh_agent_forwarding
    configure_automatic_host_dir_mounts
    configure_forward_ports
    write_compose_runtime_override
}

emit_spec_warnings() {
    if json_has_value "features"; then
        print_warning "This wrapper does not install Dev Container features. Use images that already contain required tooling."
    fi

    if json_has_value "customizations"; then
        print_warning "Editor customizations are ignored by this editor-agnostic wrapper."
    fi

    if json_has_value "remoteEnv"; then
        print_warning "remoteEnv is applied to devenv-managed shell, exec, and lifecycle commands, but not to background processes started by the container image itself."
    fi
}

