command_container_tool_check() {
    local container_id
    local failures=0
    local tool
    local check_script

    load_default_tool_args container
    validate_tool_args container

    container_id="$(ensure_running)"

    for tool in "${TOOL_ARGS[@]}"; do
        check_script="$(container_has_tool_script "$tool")"
        if run_container_shell_script "$container_id" "$check_script" >/dev/null 2>&1; then
            print_success "container tool '$tool' is installed"
        else
            print_warning "container tool '$tool' is missing"
            failures=1
        fi
    done

    return $failures
}

