}

parse_args() {
    COMMAND="open"
    EXEC_ARGS=()
    TOOL_NAME=""
    SUBCOMMAND=""
    TOOL_ARGS=()
    PRINT_ONLY=0
    local explicit_command=0

    if [[ $# -gt 0 ]]; then
        case "$1" in
            dev|vibe|ide|open|up|down|status|shell|exec|tool|host-tool|container-tool|host-tmux|logs|ps|config|check|install|uninstall|help)
                COMMAND="$1"
                explicit_command=1
                shift
                ;;
            -h|--help)
                COMMAND="help"
                shift
                ;;
        esac
    fi

    if [[ "$COMMAND" == "open" && $explicit_command -eq 1 && $# -gt 0 && "$1" != -* ]]; then
        PROJECT_NAME_OVERRIDE="$1"
        shift
    fi

    if [[ "$COMMAND" == "tool" && $# -gt 0 && "$1" != -* ]]; then
        TOOL_NAME="$1"
        shift
    fi

    if [[ ( "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ) && $# -gt 0 && "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace|-w)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                WORKSPACE_HINT="$2"
                shift 2
                ;;
            --project-name|-p)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                PROJECT_NAME_OVERRIDE="$2"
                shift 2
                ;;
            --service|-s)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                SERVICE_OVERRIDE="$2"
                shift 2
                ;;
            --prefix)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                INSTALL_PREFIX="$2"
                shift 2
                ;;
            --force)
                FORCE_INSTALL=1
                shift
                ;;
            --no-cache)
                NO_CACHE_BUILD=1
                shift
                ;;
            --rm)
                REMOVE_ON_EXIT=1
                shift
                ;;
            --print)
                PRINT_ONLY=1
                shift
                ;;
            --help|-h)
                if [[ "$COMMAND" == "tool" ]]; then
                    TOOL_NAME="help"
                    shift
                elif [[ "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ]]; then
                    SUBCOMMAND="help"
                    shift
                else
                    COMMAND="help"
                    shift
                fi
                ;;
            --)
                shift
                EXEC_ARGS=("$@")
                break
                ;;
            *)
                if [[ "$COMMAND" == "exec" ]]; then
                    EXEC_ARGS=("$@")
                    break
                fi

                if [[ "$COMMAND" == "tool" ]]; then
                    if [[ -z "$TOOL_NAME" ]]; then
                        TOOL_NAME="$1"
                        shift
                        continue
                    fi
                    EXEC_ARGS=("$@")
                    break
                fi

                if [[ "$COMMAND" == "host-tool" || "$COMMAND" == "container-tool" ]]; then
                    TOOL_ARGS+=("$1")
                    shift
                    continue
                fi

                if [[ "$COMMAND" == "logs" && -z "$SERVICE_OVERRIDE" ]]; then
                    SERVICE_OVERRIDE="$1"
                    shift
                    continue
                fi

                if [[ "$COMMAND" == "open" && $explicit_command -eq 0 ]]; then
                    die "Unknown argument: $1"
                fi

                die "Unknown argument: $1"
                ;;
        esac
    done
}

main() {
    parse_args "$@"

    case "$COMMAND" in
        help)
            usage
            return 0
            ;;
        ide)
            COMMAND="dev"
            ;;
        tool)
            if [[ -z "$TOOL_NAME" || "$TOOL_NAME" == "help" || "$TOOL_NAME" == "-h" || "$TOOL_NAME" == "--help" ]]; then
                tool_help
                return 0
            fi
            ;;
        host-tool)
            command_host_tool
            return 0
            ;;
        container-tool)
            if [[ "$SUBCOMMAND" == "help" || -z "$SUBCOMMAND" ]]; then
                command_container_tool
                return 0
            fi
            ;;
        dev|vibe|host-tmux)
            ;;
        install)
            command_install
            return 0
            ;;
        uninstall)
            command_uninstall
            return 0
            ;;
    esac

    load_workspace_context

    case "$COMMAND" in
        config)
            command_config
            ;;
        check)
            command_check
            ;;
        dev|vibe|up|down|status|shell|exec|tool|container-tool|host-tmux|logs|ps|open)
            require_runtime_prereqs
            emit_spec_warnings
            case "$COMMAND" in
                dev)
                    command_dev
                    ;;
                vibe)
                    command_vibe
                    ;;
                open)
                    command_open
                    ;;
                up)
                    command_up
                    ;;
                down)
                    command_down
                    ;;
                status)
                    command_status
                    ;;
                shell)
                    command_shell
                    ;;
                exec)
                    command_exec "${EXEC_ARGS[@]}"
                    ;;
                tool)
                    command_tool
                    ;;
                container-tool)
                    command_container_tool
                    ;;
                host-tmux)
                    command_host_tmux
                    ;;
                logs)
                    command_logs
                    ;;
                ps)
                    command_ps
                    ;;
            esac
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
