require_tool_args() {
    [[ ${#TOOL_ARGS[@]} -gt 0 ]] || die "$1"
}

load_default_tool_args() {
    local scope="$1"

    if [[ ${#TOOL_ARGS[@]} -gt 0 ]]; then
        return
    fi

    mapfile -t TOOL_ARGS < <(
        if [[ "$scope" == "host" ]]; then
            host_tool_list
        else
            container_tool_list
        fi
    )
}

validate_tool_args() {
    local scope="$1"
    local -a normalized=()
    local tool

    for tool in "${TOOL_ARGS[@]}"; do
        tool="$(normalize_helper_tool "$tool")"
        if [[ "$scope" == "host" ]]; then
            host_tool_supported "$tool" || die "Unsupported host tool '$tool'"
        else
            container_tool_supported "$tool" || die "Unsupported container tool '$tool'"
        fi
        normalized+=("$tool")
    done

    TOOL_ARGS=("${normalized[@]}")
}

host_has_tool() {
    local tool="$1"

    case "$tool" in
        jq|git|lf|yazi|lazygit|zellij|micro|fresh)
            command -v "$tool" >/dev/null 2>&1
            ;;
        helix)
            command -v hx >/dev/null 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

command_host_tool_check() {
    local failures=0
    local tool

    load_default_tool_args host
    validate_tool_args host

    for tool in "${TOOL_ARGS[@]}"; do
        if host_has_tool "$tool"; then
            print_success "host tool '$tool' is installed"
        else
            print_warning "host tool '$tool' is missing"
            failures=1
        fi
    done

    return $failures
}

detect_host_package_manager() {
    if command -v apt-get >/dev/null 2>&1; then
        printf 'apt-get\n'
        return
    fi
    if command -v dnf >/dev/null 2>&1; then
        printf 'dnf\n'
        return
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf 'pacman\n'
        return
    fi
    if command -v zypper >/dev/null 2>&1; then
        printf 'zypper\n'
        return
    fi
    if command -v apk >/dev/null 2>&1; then
        printf 'apk\n'
        return
    fi

    die "No supported package manager found on the host"
}

